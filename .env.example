# Application
APP_NAME=autonomous-support
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Persistence (SQLite for local mock; Postgres in Docker Compose)
DATABASE_URL=sqlite+pysqlite:///./data/support.db
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Auth seed keys (development only)
DEMO_TENANT_ID=tenant_demo
DEMO_CUSTOMER_API_KEY=demo_customer_key
DEMO_AGENT_API_KEY=demo_agent_key
DEMO_ADMIN_API_KEY=demo_admin_key

# Orchestration
MAX_RETRIES=2
MAX_SPECIALIST_HANDOFFS=3
RATE_LIMIT_PER_MINUTE=60

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=autonomous-support
